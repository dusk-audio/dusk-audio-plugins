# CLAP plugin format helper.
#
# Wraps clap_juce_extensions_plugin() so per-plugin CMakeLists only need to
# pass the target name, slug, and CLAP feature tags.
#
# Usage (after juce_add_plugin):
#   apply_clap_extension(DuskVerb duskverb audio-effect reverb stereo)
#
# Produces a <TARGET>_CLAP target. CLAP_ID is fixed to com.dusk-audio.<slug>.
# No-op if BUILD_CLAP is OFF (e.g. when the submodule is missing).

function(apply_clap_extension TARGET_NAME CLAP_SLUG)
    if(NOT BUILD_CLAP)
        return()
    endif()

    set(FEATURES ${ARGN})
    if(NOT FEATURES)
        message(FATAL_ERROR
            "apply_clap_extension(${TARGET_NAME} ${CLAP_SLUG}): at least one CLAP feature tag is required")
    endif()

    clap_juce_extensions_plugin(
        TARGET ${TARGET_NAME}
        CLAP_ID "com.dusk-audio.${CLAP_SLUG}"
        CLAP_FEATURES ${FEATURES}
        CLAP_MANUAL_URL "https://dusk-audio.github.io/plugins/${CLAP_SLUG}"
        CLAP_SUPPORT_URL "https://dusk-audio.github.io"
    )
endfunction()

# The pinned upstream adapter has no generic read-only-parameter capability.
# Compile a project-owned copy for opted-in plugins; keep the submodule and
# every other plugin's wrapper unchanged. A tag preserves JUCE choice/text units
# instead of abusing its meter category (AU maps that to logarithmic gain).
function(dusk_clap_enable_output_parameters target)
    if(NOT TARGET ${target}_CLAP)
        return()
    endif()
    get_target_property(wrapper_root clap_juce_sources CLAP_JUCE_SOURCE_DIR)
    set(original "${wrapper_root}/src/wrapper/clap-juce-wrapper.cpp")
    set(original_mac "${wrapper_root}/src/wrapper/clap-juce-mac.mm")
    file(READ "${original}" wrapper)
    set(anchor [=[        if (paramVariant.processorParam->isAutomatable())
            info->flags = info->flags | CLAP_PARAM_IS_AUTOMATABLE;]=])
    string(REPLACE "${anchor}" "" without_anchor "${wrapper}")
    string(LENGTH "${wrapper}" before_length)
    string(LENGTH "${without_anchor}" after_length)
    string(LENGTH "${anchor}" anchor_length)
    math(EXPR removed_length "${before_length} - ${after_length}")
    if(NOT removed_length EQUAL anchor_length)
        message(FATAL_ERROR "CLAP output compatibility hook needs review: expected one parameter-flags anchor")
    endif()
    set(replacement [=[        if (dynamic_cast<const DuskClapOutputParameterTag*>(paramVariant.processorParam))
            info->flags = info->flags | CLAP_PARAM_IS_READONLY;
        else if (paramVariant.processorParam->isAutomatable())
            info->flags = info->flags | CLAP_PARAM_IS_AUTOMATABLE;]=])
    string(REPLACE "${anchor}" "${replacement}" wrapper "${wrapper}")
    set(generated "${CMAKE_BINARY_DIR}/dusk-clap-output-wrapper")
    file(MAKE_DIRECTORY "${generated}")
    file(WRITE "${generated}/wrapper.tmp" "// Generated by dusk_clap_enable_output_parameters; upstream MIT notice follows.\n#include \"DuskClapOutputParameter.h\"\n${wrapper}")
    configure_file("${generated}/wrapper.tmp" "${generated}/clap-juce-wrapper.cpp" COPYONLY)
    file(REMOVE "${generated}/wrapper.tmp")
    configure_file("${original_mac}" "${generated}/clap-juce-mac.mm" COPYONLY)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${original}")

    # Replace only this module's source-bearing interface. Preserve all of the
    # original includes, standard, plugin definitions and other link dependencies.
    foreach(property LINK_LIBRARIES INTERFACE_LINK_LIBRARIES)
        get_target_property(links ${target}_CLAP ${property})
        if(links)
            list(REMOVE_ITEM links clap_juce_sources)
            set_property(TARGET ${target}_CLAP PROPERTY ${property} "${links}")
        endif()
    endforeach()
    get_target_property(owned_sources ${target}_CLAP SOURCES)
    if(owned_sources)
        list(REMOVE_ITEM owned_sources "${original}" "${original_mac}")
        set_property(TARGET ${target}_CLAP PROPERTY SOURCES "${owned_sources}")
    endif()
    get_filename_component(repo_root "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/.." ABSOLUTE)
    target_include_directories(${target}_CLAP PRIVATE "${repo_root}/plugins/shared"
        "$<TARGET_PROPERTY:clap_juce_sources,INTERFACE_INCLUDE_DIRECTORIES>")
    if(APPLE)
        target_sources(${target}_CLAP PRIVATE "${generated}/clap-juce-mac.mm")
    else()
        target_sources(${target}_CLAP PRIVATE "${generated}/clap-juce-wrapper.cpp")
    endif()
endfunction()
